{
  "name": "buzz-slack-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable Matrix-to-Buzz adapter for mautrix-slack deployments",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run test && npm run build",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check . && tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "nostr-tools": "2.24.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
